# Nur die eigene Rice-Konfig tracken, alles andere ignorieren:
/*
!/hypr/
!/quickshell/
!/dynamic-island/
!/README.md
# Die eigenen Wallpaper (die Sammlung aus dem fremden Repo bleibt draussen)
!/wallpapers/
!/hyprlock/

# innerhalb von quickshell nur die eigene Shell
/quickshell/*
!/quickshell/dynamic-island/

# Shell-Einstellungen: pro Rechner, die Vorgaben stehen im Code
# (quickshell/dynamic-island/modules/services/config/Config.qml)
/dynamic-island/shell.json

# lokale/privates
.claude/
.qmlls.ini
__pycache__/
*.pyc

# hyprlock: die Bildersammlung aus dem fremden Repo bleibt draussen,
# die Layouts/Skripte werden getrackt
/hyprlock/wallpapers/

# Aus dem Farbschema erzeugt (dynamic-island scheme/wallpaper). Aendert sich
# bei jedem Theme- und Wallpaperwechsel -- gehoert nicht in die Versionierung.
# Die Vorlagen bleiben getrackt: hypr/scheme/default.lua und
# dynamic-island/src/dynamic_island/data/templates/hyprlock.conf.
# install.sh (seed_scheme) legt beide nach einem frischen Clone wieder an.
/hypr/scheme/current.lua
/hypr/scheme/hyprlock.conf
