{
    "$schema": "../plugin.schema.json",
    "id": "wallhaven",
    "name": "Wallhaven",
    "version": "1.0.0",
    "api": 1,
    "author": "Gamecat",
    "icon": "travel_explore",
    "homepage": "https://wallhaven.cc",
    "description": "Wallhaven-Suche in der Wallpaper-Auswahl: eigene Sektion mit Treffer-Karussell, Vorschau auf dem Hintergrund, Download in Wallpapers/Wallhaven. SUPER+ALT+W oder Strg+W in der Auswahl.",
    "defaultEnabled": true,
    "main": "Main.qml",
    "migrateFrom": "wallhaven",
    "keybinds": {
        "open": { "keys": "SUPER + ALT + W", "title": "Wallhaven-Suche", "group": "Werkzeuge", "ipc": "open" }
    },
    "panels": {
        "wallpaper": { "component": "Section.qml", "icon": "travel_explore" }
    },
    "settings": {
        "fullPreview": {
            "default": true,
            "title": "Vorschau in voller Qualität",
            "desc": "Bleibt die Auswahl kurz auf einem Treffer stehen, lädt das Vollbild in den Cache und der Hintergrund zeigt es scharf statt als Thumb. Aus bei langsamem Netz"
        },
        "sorting": {
            "default": "top",
            "title": "Sortierung",
            "desc": "Reihenfolge der Treffer; steht auch als Chips in der Auswahl",
            "options": ["relevanz", "neu", "zufall", "views", "favoriten", "top"]
        },
        "topRange": {
            "default": "1 Monat",
            "title": "Top-Zeitraum",
            "desc": "Zeitraum der Toplist",
            "options": ["1 Tag", "3 Tage", "1 Woche", "1 Monat", "3 Monate", "6 Monate", "1 Jahr"],
            "requires": { "sorting": "top" }
        },
        "purity": {
            "default": "sfw",
            "title": "Inhalt",
            "desc": "sfw: nur jugendfrei. sketchy: dazu Grenzfälle (NSFW nur mit API-Key: python3 -I wallhaven.py key <KEY> im Plugin-Ordner)",
            "options": ["sfw", "sfw+sketchy"]
        },
        "categories": {
            "default": "alle",
            "title": "Kategorien",
            "desc": "Welche Wallhaven-Kategorien die Suche durchsucht",
            "options": ["alle", "general", "anime", "people", "general+anime"]
        },
        "atleast": {
            "default": "aus",
            "title": "Mindestauflösung",
            "desc": "Kleinere Bilder fliegen raus",
            "options": ["aus", "1920x1080", "2560x1440", "3840x2160"]
        },
        "ratios": {
            "default": "alle",
            "title": "Seitenverhältnis",
            "desc": "Nur Bilder in diesem Format",
            "options": ["alle", "16x9", "16x10", "21x9"]
        }
    }
}
